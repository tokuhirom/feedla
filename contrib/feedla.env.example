# /etc/default/feedla — contrib/feedla.service が読む設定。
#
# イメージを更新するときは、このファイルのタグを書き換えて
#   sudo systemctl restart feedla
# だけで済む（unit ファイル自体は触らない）。

# 差し替えるリリースを明示する。latest は使わず、意図したバージョンに固定する。
FEEDLA_IMAGE=ghcr.io/tokuhirom/feedla:2026.816.1

# ホスト側の bind アドレス。<ip>:<port> 形式。
# Tailscale 経由でのみ見せる場合は tailscale0 の IP を指定する（`tailscale ip -4`）。
# 全インターフェースに公開してよいなら 0.0.0.0:8080。
FEEDLA_BIND=100.112.5.24:8080
